{
  "name": "vscode-fabric-supersat",
  "displayName": "Fabric Supersat",
  "description": "A Microsoft Fabric VS Code extension that takes a source code first approach.",
  "version": "0.0.1",
  "publisher": "vscode-fabric-supersat",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vscode-fabric-supersat/vscode-fabric-supersat.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, notebook files aren't updated automatically, and the folder's .fabric-supersat/settings.yaml isn't used (the Fabric workspace comes from your user settings until you trust the folder)."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "fabric-supersat.showLog",
        "title": "Show Log",
        "category": "Fabric Supersat"
      },
      {
        "command": "fabric-supersat.openSettings",
        "title": "Open Settings",
        "category": "Fabric Supersat"
      },
      {
        "command": "fabric-supersat.signIn",
        "title": "Sign In to Fabric",
        "category": "Fabric Supersat"
      },
      {
        "command": "fabric-supersat.signOut",
        "title": "Sign Out of Fabric",
        "category": "Fabric Supersat"
      },
      {
        "command": "fabric-supersat.configureSignIn",
        "title": "Configure Sign-In",
        "category": "Fabric Supersat"
      },
      {
        "command": "fabric-supersat.selectWorkspace",
        "title": "Select Workspace",
        "category": "Fabric Supersat"
      },
      {
        "command": "fabric-supersat.downloadNotebook",
        "title": "Download Notebook",
        "category": "Fabric Supersat"
      },
      {
        "command": "fabric-supersat.downloadAllNotebooks",
        "title": "Download All Notebooks",
        "category": "Fabric Supersat"
      },
      {
        "command": "fabric-supersat.newNotebook",
        "title": "Create New Fabric Notebook",
        "category": "Fabric Supersat"
      },
      {
        "command": "fabric-supersat.uploadNotebook",
        "title": "Save and Upload Notebook",
        "category": "Fabric Supersat",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "fabric-supersat.uploadAllNotebooks",
        "title": "Upload All Notebooks",
        "category": "Fabric Supersat"
      }
    ],
    "notebooks": [
      {
        "type": "fabric-supersat-notebook",
        "displayName": "Fabric Notebook (Git format)",
        "selector": [
          {
            "filenamePattern": "*.py"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "notebook/toolbar": [
        {
          "command": "fabric-supersat.uploadNotebook",
          "group": "navigation@99",
          "when": "notebookType == fabric-supersat-notebook || resourcePath =~ /[\\\\/]\\.fabric-supersat[\\\\/]Notebooks[\\\\/]([^\\\\/]+)[\\\\/]\\1\\.ipynb$/"
        }
      ],
      "editor/title": [
        {
          "command": "fabric-supersat.uploadNotebook",
          "group": "navigation",
          "when": "activeEditor != workbench.editor.notebook && resourcePath =~ /[\\\\/]src[\\\\/]Notebooks[\\\\/]([^\\\\/]+)[\\\\/]\\1\\.py$/"
        }
      ]
    },
    "yamlValidation": [
      {
        "fileMatch": "**/.fabric-supersat/settings.yaml",
        "url": "./schemas/settings.schema.json"
      },
      {
        "fileMatch": "**/src/Notebooks/*/notebook.yaml",
        "url": "./schemas/notebook.schema.json"
      }
    ],
    "configuration": {
      "title": "Fabric Supersat",
      "properties": {
        "fabric-supersat.workspace.name": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Name of the Fabric workspace that commands work in when no folder is open (or the folder isn't trusted). Its ID is looked up in Fabric by this name; a name shared by more than one workspace is refused. With a trusted folder open, **Fabric Supersat: Select Workspace** saves the name in `.fabric-supersat/settings.yaml` in that folder (ignored by git) instead, and this setting is ignored."
        }
      }
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "**/src/Notebooks/*/*.py": "fabric-supersat-notebook",
        "**/*.Notebook/notebook-content.py": "fabric-supersat-notebook"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "vscode-test",
    "pretest:web": "npm run compile",
    "test:web": "vscode-test-web --browserType=chromium --headless --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/index.js",
    "run:web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
    "vsce:package": "vsce package",
    "icon": "node scripts/render-icon.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.0",
    "assert": "^2.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "mocha": "^12.0.3",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.65.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": {
        "serialize-javascript": "^7.1.4",
        "diff": "^8.0.3"
      }
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
